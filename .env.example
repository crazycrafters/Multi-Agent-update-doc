RESUME_OPENAI_KEY=
# OPENAI_API_KEY is also accepted for standard local setups.
RESUME_MODEL=gpt-4.1-mini
INTERVIEWEE_MODEL=gpt-4.1-mini
INTERVIEWER_MODEL=gpt-4.1-mini
POSTGRES_PASSWORD=local-resume-development
API_ACCESS_TOKEN=
# Estimates are displayed only if all applicable pricing is configured.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=
# WEB_SEARCH_USD_PER_CALL=
MAX_ITERATION_TOKENS=150000

# Codex uses its account default when unset; optional explicit model override:
# CODEX_MODEL=
# Local non-Docker overrides: RESUME_CODEX_BINARY, RESUME_CODEX_HOME
# Optional per-agent: CODEX_RESUME_MODEL, CODEX_INTERVIEWEE_MODEL, CODEX_INTERVIEWER_MODEL
